<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <!-- 背景：清潔感のあるホワイトと柔らかな丸み -->
  <rect width="512" height="512" rx="112" fill="#ffffff"/>
  
  <!-- 外枠（ほんのり薄いグレー） -->
  <rect x="8" y="8" width="496" height="496" rx="104" fill="none" stroke="#f1f5f9" stroke-width="16"/>

  <!-- アイコン中央のテキスト「ADカレ」（AD: オレンジ, カレ: 黒） -->
  <text x="50%" y="54%" dominant-baseline="central" text-anchor="middle" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" font-weight="900" font-size="115" letter-spacing="-2">
    <tspan fill="#f97316">AD</tspan><tspan fill="#0f172a">カレ</tspan>
  </text>
</svg>
